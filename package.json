{
  "name": "mcp-branch-render-document",
  "version": "1.0.0",
  "description": "Branch Render Context MCP - Context caching & incremental git updates for AI agents",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "branch-render": "./dist/cli/index.js"
  },
  "scripts": {
    "setup": "node scripts/ensure-dependencies.mjs",
    "build": "node scripts/ensure-dependencies.mjs && tsc",
    "branch-render:start": "node scripts/ensure-dependencies.mjs && tsx src/cli/index.ts start",
    "branch-render:list": "node scripts/ensure-dependencies.mjs && tsx src/cli/index.ts list",
    "branch-render:status": "node scripts/ensure-dependencies.mjs && tsx src/cli/index.ts status",
    "branch-render:refresh": "node scripts/ensure-dependencies.mjs && tsx src/cli/index.ts refresh",
    "branch-render:clear": "node scripts/ensure-dependencies.mjs && tsx src/cli/index.ts clear",
    "mcp:start": "node scripts/ensure-dependencies.mjs && tsx src/index.ts",
    "test": "node scripts/ensure-dependencies.mjs && vitest run"
  },
  "keywords": ["mcp", "git", "context", "ai-agent"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.6.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
